{
  "manifest_version": 3,
  "name": "Amazon Listing Keyword Optimizer",
  "version": "1.1.0",
  "description": "A local keyword workspace and listing optimizer for Amazon Merch on Demand.",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://www.amazon.com/*", "https://amazon.com/*", "https://www.amazon.co.uk/*", "https://amazon.co.uk/*", "https://www.amazon.de/*", "https://amazon.de/*", "https://completion.amazon.com/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Amazon Listing Keyword Optimizer", "default_popup": "popup/popup.html", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "side_panel": { "default_path": "sidepanel/panel.html" },
  "content_scripts": [{ "matches": ["https://www.amazon.com/s*", "https://amazon.com/s*", "https://www.amazon.com/dp/*", "https://amazon.com/dp/*", "https://www.amazon.com/gp/product/*", "https://amazon.com/gp/product/*", "https://www.amazon.co.uk/s*", "https://amazon.co.uk/s*", "https://www.amazon.co.uk/dp/*", "https://amazon.co.uk/gp/product/*", "https://www.amazon.de/s*", "https://amazon.de/s*", "https://www.amazon.de/dp/*", "https://amazon.de/gp/product/*"], "js": ["content/selectors.js", "lib/keywords.js", "content/amazon.js"], "run_at": "document_idle" }],
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
